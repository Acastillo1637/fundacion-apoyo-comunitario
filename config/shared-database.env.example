# Copia este archivo como .env.shared en la raiz del proyecto.
# Cada integrante configura su copia privada; nunca subir credenciales a GitHub.
# Usa los valores de Connect > Session pooler en Supabase, puerto 5432.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require
# Misma clave privada en ambos equipos. No uses la clave publica de desarrollo.
# Generar una sola vez: .venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
