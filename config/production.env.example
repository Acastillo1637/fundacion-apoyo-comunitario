# Copiar fuera de la web, por ejemplo /etc/fundacion/backend.env (modo 600).
# Este archivo no ejecuta comandos; systemd carga KEY=value literalmente.
DJANGO_DEBUG=false
# Si conservas la base actual, conserva también su clave Django privada:
# cifrado 2FA, firmas y sesiones dependen de ella. No generes otra al migrar.
DJANGO_SECRET_KEY=
FOUNDATION_NAME=Fundación Apoyo Comunitario
DJANGO_ALLOWED_HOSTS=
PUBLIC_APP_URL=
DJANGO_CSRF_TRUSTED_ORIGINS=
# Solo con el proxy Nginx propio y Gunicorn inaccesible desde internet.
DJANGO_TRUST_PROXY=true
DATABASE_ENGINE=postgresql
POSTGRES_HOST=
POSTGRES_PORT=6543
POSTGRES_DB=postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=verify-full
POSTGRES_SSLROOTCERT=
PRIVATE_DOCUMENT_ROOT=/var/lib/fundacion/documents
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
GEOAPIFY_API_KEY=
# Texto/plazo aprobado por la fundación; no reemplazar por un plazo inventado.
DATA_RETENTION_NOTICE=
