# Copiar a .env para Docker Compose. Nunca subir el .env real.
FOUNDATION_NAME=Fundación Apoyo Comunitario
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Producción: solo orígenes HTTPS propios, separados por coma, si se necesitan.
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_ENGINE=postgresql
POSTGRES_DB=fundacion
POSTGRES_USER=fundacion_app
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Interno al VPS: obligatorio antes de habilitar cargas en producción.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Ruta opcional, fuera del directorio público. No subir su contenido a GitHub.
PRIVATE_DOCUMENT_ROOT=
