# Plantilla única de PRODUCCIÓN. No se carga automáticamente ni se usa como .env.shared.
# Desarrollo compartido: config/shared-database.env.example. Guía: docs/CONFIGURACION.md.
# Copiar fuera de la web, por ejemplo /etc/fundacion/backend.env (modo 600).
# Este archivo no ejecuta comandos; systemd carga KEY=value literalmente.
# Aplicación e identidad
DJANGO_DEBUG=false
# Si conservas la base actual, conserva también su clave Django privada:
# cifrado 2FA, firmas y sesiones dependen de ella. No generes otra al migrar.
DJANGO_SECRET_KEY=
FOUNDATION_NAME=Fundación Apoyo Comunitario
# Hosts sin https://; separados por coma. URL pública con https://, sin ruta.
DJANGO_ALLOWED_HOSTS=
PUBLIC_APP_URL=
DJANGO_CSRF_TRUSTED_ORIGINS=
# Solo con el proxy Nginx propio y Gunicorn inaccesible desde internet.
DJANGO_TRUST_PROXY=true
DATABASE_ENGINE=postgresql
# Conexión PostgreSQL de Supabase (Connect), no claves anon/service_role.
POSTGRES_HOST=
POSTGRES_PORT=6543
POSTGRES_DB=postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=verify-full
# Ruta del certificado CA del proveedor cuando sea necesario para verificar TLS.
POSTGRES_SSLROOTCERT=
# Archivos privados y antivirus: fuera del directorio público y de la red pública.
PRIVATE_DOCUMENT_ROOT=/var/lib/fundacion/documents
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Correo real: STARTTLS/587 = TLS true, SSL false; TLS implícito/465 = false/true.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Opcional: cálculo de referencia por domicilio; la clave permanece en Django.
GEOAPIFY_API_KEY=
# Texto/plazo aprobado por la fundación; no reemplazar por un plazo inventado.
DATA_RETENTION_NOTICE=

# Opcionales: valores predeterminados del backend. Nominatim es solo para lugares públicos.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GEOCODING_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=FundacionApoyoComunitario-PRO12/1.0
