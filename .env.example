# Configuracion del backend en el hosting. PostgreSQL definitivo: Supabase.
# Nunca subir el .env real. El servidor debe cargar estas variables de entorno.
FOUNDATION_NAME=Fundación Apoyo Comunitario
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Producción: solo orígenes HTTPS propios, separados por coma, si se necesitan.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Dirección pública del frontend. Producción: dominio propio HTTPS.
PUBLIC_APP_URL=
DATABASE_ENGINE=postgresql
POSTGRES_DB=postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
# Supabase: copiar el endpoint PostgreSQL del proyecto de produccion.
# require exige cifrado; verify-full requiere ademas configurar el certificado.
POSTGRES_SSLMODE=require
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Interno al VPS: obligatorio antes de habilitar cargas en producción.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Ruta opcional, fuera del directorio público. No subir su contenido a GitHub.
PRIVATE_DOCUMENT_ROOT=
